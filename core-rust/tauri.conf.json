{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morph",
  "version": "8.7.0",
  "identifier": "com.morph.tunnel",
  "build": {
    "frontendDist": "../desktop-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Morph Core — Fast UDP Tunnel",
        "width": 420,
        "height": 680,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.ico",
      "tooltip": "Morph Fast UDP Tunnel"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
